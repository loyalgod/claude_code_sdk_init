# ===== 必填 =====
# Anthropic API Key：SDK 与本地配置均读取该变量（字段 anthropic_api_key 不区分大小写）
ANTHROPIC_API_KEY=

# ===== 可选（字段名大写即环境变量名）=====
# 使用的模型
AGENT_MODEL=claude-sonnet-4-20250514

# Agent 名称（系统提示词里展示）
AGENT_NAME=my-agent

# MCP 工具服务器名称（tool 全名形如 mcp__<name>__<tool>）
MCP_SERVER_NAME=myagent

# 单轮最大工具调用轮数
MAX_TURNS=20

# 单轮超时（秒）
AGENT_TIMEOUT_SECONDS=300

# 权限模式：default / acceptEdits / bypassPermissions / plan
PERMISSION_MODE=default

# Agent 工作目录（工具默认相对路径的根）
AGENT_CWD=.

# 允许的 SDK 内置工具（JSON 数组）
ALLOWED_BUILTIN_TOOLS=["Read","Glob","Grep"]

# 禁止的 SDK 内置工具（JSON 数组）
DISALLOWED_TOOLS=["Write","Edit","Bash","NotebookEdit","WebFetch","WebSearch","Task","Agent"]
